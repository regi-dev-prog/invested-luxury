# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=4b3ap7pf
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# On-demand revalidation (Sanity webhook + manual cache busting via /api/revalidate)
# Generate with: openssl rand -base64 32
REVALIDATE_SECRET=

# Site URL
NEXT_PUBLIC_SITE_URL=https://investedluxury.com

# Analytics (optional)
NEXT_PUBLIC_GA_ID=

# Kit (formerly ConvertKit) — newsletter ESP. Used by /api/newsletter.
# API key: Kit dashboard → Settings → Advanced → API → V4 API Key
KIT_API_KEY=
# Numeric tag id for the "source:site-form" tag (used to tag site signups).
# Find it via GET https://api.kit.com/v4/tags or the Kit dashboard.
KIT_TAG_SITE_FORM_ID=

# Weekly newsletter engine (scripts/newsletter/run.mjs)
# Anthropic API key — writes the issue copy with claude-sonnet-4-6.
ANTHROPIC_API_KEY=
# Safety switch. Unset/false: the engine only creates a DRAFT in Kit.
# Set to "true" to actually send the broadcast.
NEWSLETTER_AUTOSEND=false
# Shared secret so the engine's link QA check can bypass the site's own rate
# limiter (middleware.ts). Generate with: openssl rand -hex 32
NEWSLETTER_BYPASS_TOKEN=
